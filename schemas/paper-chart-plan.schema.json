{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Chart Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "type", "title", "subtitle", "theme", "canvas", "data", "encoding", "options"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "const": "paper-chart" },
    "type": { "enum": ["line", "bar", "scatter", "heatmap", "boxplot", "radar", "errorbar"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "subtitle": { "type": "string", "maxLength": 120 },
    "theme": { "enum": ["academic-blue", "academic-green", "minimal-gray"] },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 1600 },
        "height": { "const": 1000 }
      }
    },
    "data": {
      "type": "object",
      "required": ["source", "sheet", "row_count", "columns"],
      "properties": {
        "source": { "type": "string" },
        "sheet": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 1 },
        "columns": { "type": "array", "minItems": 1 }
      }
    },
    "encoding": {
      "type": "object",
      "required": ["x", "y", "error", "series", "x_title", "y_title"],
      "properties": {
        "x": { "type": "string" },
        "y": { "type": "array", "items": { "type": "string" } },
        "error": { "type": "string" },
        "series": { "type": "string" },
        "x_title": { "type": "string" },
        "y_title": { "type": "string" }
      }
    },
    "options": {
      "type": "object",
      "required": ["show_grid", "show_legend", "y_zero", "accent", "note"],
      "properties": {
        "show_grid": { "type": "boolean" },
        "show_legend": { "type": "boolean" },
        "y_zero": { "type": "boolean" },
        "accent": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
