{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.html-ppt.dev/schemas/figure-suite-plan.schema.json",
  "title": "Figure Suite Plan",
  "type": "object",
  "required": ["schema_version", "mode", "paper_title", "global_style", "figures", "coverage"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "const": "figure-suite" },
    "paper_title": { "type": "string", "minLength": 1 },
    "global_style": { "type": "object" },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "section", "engine", "visual_type", "purpose", "required_inputs", "source_trace", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2}$" },
          "section": { "type": "string" },
          "engine": { "enum": ["paper-visual", "paper-chart", "model-diagram"] },
          "visual_type": { "type": "string" },
          "required_inputs": { "type": "array", "minItems": 1 },
          "source_trace": { "type": "string", "minLength": 1 },
          "status": { "const": "planned" }
        }
      }
    },
    "coverage": { "type": "object" }
  }
}
