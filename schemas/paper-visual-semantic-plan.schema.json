{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "type",
    "title",
    "subtitle",
    "theme",
    "groups",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper-visual-semantic"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "flowchart",
        "mindmap",
        "architecture",
        "hierarchy",
        "feedback-loop",
        "timeline"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "subtitle": {
      "type": "string",
      "maxLength": 80
    },
    "theme": {
      "type": "string",
      "enum": [
        "academic-blue",
        "academic-green",
        "academic-orange",
        "minimal-gray"
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G[1-9][0-9]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "label",
          "detail",
          "shape",
          "tag"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^N[1-9][0-9]*$"
          },
          "group": {
            "type": "string",
            "pattern": "^G[1-9][0-9]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "detail": {
            "type": "string",
            "maxLength": 60
          },
          "shape": {
            "type": "string",
            "enum": [
              "process",
              "decision",
              "pill"
            ]
          },
          "tag": {
            "type": "string",
            "maxLength": 12
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "label",
          "start_arrow",
          "end_arrow"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[1-9][0-9]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^N[1-9][0-9]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^N[1-9][0-9]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flow",
              "pass",
              "reject",
              "feedback"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 16
          },
          "start_arrow": {
            "type": "string",
            "enum": [
              "none",
              "triangle",
              "dot",
              "diamond"
            ]
          },
          "end_arrow": {
            "type": "string",
            "enum": [
              "none",
              "triangle",
              "dot",
              "diamond"
            ]
          }
        }
      }
    }
  }
}
