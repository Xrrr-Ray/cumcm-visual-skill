    "agenda": { "scenario": "展示汇报结构", "recommendedItems": "4-8", "recommendedChars": 90, "imageRatio": "无", "minFont": 22, "safeMargin": 80, "components": ["numbered-list"], "avoid": "不要把目录写成正文摘要" },
    "section-divider": { "scenario": "章节过渡与节奏调整", "recommendedItems": "1", "recommendedChars": 35, "imageRatio": "可选全幅", "minFont": 32, "safeMargin": 80, "components": ["section-number"], "avoid": "不承载复杂证据" },
    "single-message": { "scenario": "突出一个关键判断或结论", "recommendedItems": "1-3", "recommendedChars": 100, "imageRatio": "可选 1:1", "minFont": 24, "safeMargin": 96, "components": ["evidence-list"], "avoid": "不要并列多个无关主题" },
    "text-image": { "scenario": "文字解释为主、图像证据为辅", "recommendedItems": "2-4", "recommendedChars": 150, "imageRatio": "4:3", "minFont": 20, "safeMargin": 80, "components": ["image-text"], "avoid": "没有真实图片或图示时不要强行使用" },
    "image-text": { "scenario": "图像证据为主、文字结论为辅", "recommendedItems": "1-3", "recommendedChars": 120, "imageRatio": "4:3", "minFont": 20, "safeMargin": 80, "components": ["image-text"], "avoid": "图像与结论无关时不要使用" },
    "three-columns": { "scenario": "三个并列模块、目标或贡献", "recommendedItems": "3", "recommendedChars": 150, "imageRatio": "无", "minFont": 19, "safeMargin": 80, "components": ["pillar"], "avoid": "项目不是三个时不要硬凑三栏" },
    "comparison": { "scenario": "方法、方案或前后状态对比", "recommendedItems": "2-4", "recommendedChars": 180, "imageRatio": "无", "minFont": 18, "safeMargin": 80, "components": ["comparison", "table"], "avoid": "比较维度不一致时不要使用" },
    "timeline": { "scenario": "里程碑、阶段与时间进程", "recommendedItems": "3-6", "recommendedChars": 140, "imageRatio": "无", "minFont": 18, "safeMargin": 80, "components": ["timeline"], "avoid": "没有时间顺序时不要使用" },
    "flowchart": { "scenario": "算法流程、技术路线、研究框架与协作机制", "recommendedItems": "3-7", "recommendedChars": 150, "imageRatio": "无", "minFont": 18, "safeMargin": 80, "components": ["flowchart", "process", "architecture"], "avoid": "项目之间没有方向关系时不要使用" },
    "data-chart": { "scenario": "趋势、构成或多指标证据", "recommendedItems": "2-6", "recommendedChars": 120, "imageRatio": "16:9", "minFont": 18, "safeMargin": 80, "components": ["bar-chart", "line-chart", "table"], "avoid": "输入没有数值时不得编造图表刻度" },
    "metric-overview": { "scenario": "展示 2-4 个关键数字", "recommendedItems": "2-4", "recommendedChars": 100, "imageRatio": "无", "minFont": 18, "safeMargin": 80, "components": ["metric-card"], "avoid": "不要用无上下文的孤立数字" },
    "summary": { "scenario": "结论、边界和下一步", "recommendedItems": "1-3", "recommendedChars": 150, "imageRatio": "可选 16:9", "minFont": 22, "safeMargin": 96, "components": ["summary", "callout"], "avoid": "不得新增输入中不存在的研究结论" }
  }
